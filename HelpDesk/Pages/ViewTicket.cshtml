@page "/ticket/{id:int}"
@model HelpDesk.Pages.ViewTicketModel
@using HelpDesk.Models
@{
    ViewData[index: "Title"] = "View Ticket";
}

<h1>@ViewData[index: "Title"]</h1>

@if (Model.Ticket == null)
{
    <p>Ticket not found.</p>
}
else
{
    <div class="message-card">
        <div class="message-header">
            <h2 class="message-title">
                @Model.Ticket.Title
            </h2>
            <p class="author-id">
                User ID: @Model.Ticket.UserId
            </p>
        </div>
        <p class="message-content">
            @Model.Ticket.Text
        </p>
        
        <p>Status: @(Model.Ticket.Open ? "Open" : "Closed")</p>

        <h3>New message</h3>

        <form method="post" asp-page-handler="SendMessage">
            <input type="hidden" name="ticket_id" value="@Model.Ticket.Id" />

            <label asp-for="Text"></label>
            <input asp-for="Text" class="input-field" />

            <span asp-validation-for="Text"></span>

            <button type="submit">Send</button>
        </form>

        <h3>Exchange</h3>

        <ul>
            @foreach (Message Message in Model.Ticket.Exchange)
            {
                <li>
                    <strong>User @Message.UserId:</strong>
                    @Message.Text
                </li>
            }
        </ul>
    </div>
}