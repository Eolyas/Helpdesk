@page "/ticket/{id:int}"
@model ViewTicketModel
@using HelpDesk.Models
@using HelpDesk.Helpers

@{
    ViewData[index: "Title"] = "View Ticket";
}

<div class="ticket-page">
    @if (Model.Ticket == null)
    {
        <section class="ticket-empty">
            <div class="ticket-empty__icon">!</div>
            <h1>Ticket not found</h1>
            <p>The requested ticket does not exist or is no longer available.</p>
            <a asp-page="/Index" class="button button--secondary">
                Back to tickets
            </a>
        </section>
    }
    else
    {
        <main class="ticket-container">
            <header class="ticket-header">
                <div class="ticket-header__content">
                    <div class="ticket-reference">
                        Ticket #@Model.Ticket.TicketId
                    </div>

                    <h1 class="ticket-title">
                        @Model.Ticket.Title
                    </h1>

                    <div class="ticket-meta">
                        <span class="ticket-author">
                            <span class="ticket-avatar">
                                @Model.Ticket.User.UserId
                            </span>

                            <span>
                                <strong>
                                    @Model.Ticket.User.FirstName
                                    @Model.Ticket.User.LastName
                                </strong>
                            </span>
                        </span>

                        <span class="ticket-date">
                            @Model.Ticket.CreationDate.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                </div>

                <section class="ticket-labels">
                    <div class="ticket-labels__header">
                        <h2>Labels</h2>
                    </div>

                    <div class="ticket-labels__list">
                        @if (Model.Ticket.Labels.Any())
                        {
                            @foreach (Label label in Model.Ticket.Labels.OrderBy(label => label.Name))
                            {
                                <span class="ticket-label">
                                    @label.Name
                                </span>
                            }
                        }
                        else
                        {
                            <span class="ticket-labels__empty">
                                No labels assigned
                            </span>
                        }
                    </div>

                    <form method="post"
                        asp-page-handler="AddLabel"
                        class="ticket-label-form">

                        <input type="hidden"
                            name="TicketId"
                            value="@Model.Ticket.TicketId" />

                        <input asp-for="NewLabelName"
                            class="ticket-label-form__input"
                            list="existing-labels"
                            maxlength="50"
                            autocomplete="off"
                            placeholder="Label" />

                        <datalist id="existing-labels">
                            @foreach (Label label in Model.Labels.Where(label => !Model.Ticket.Labels.Any(assigned => assigned.LabelId == label.LabelId)))
                            {
                                <option value="@label.Name"></option>
                            }
                        </datalist>

                        <span asp-validation-for="NewLabelName"
                            class="validation-error">
                        </span>

                        <button type="submit"
                                class="ticket-label-form__button">
                            <span aria-hidden="true">+</span>
                            Add label
                        </button>
                    </form>
                </section>

                <form method="post"
                    asp-page-handler="ChangeStatus">

                    <input type="hidden"
                        name="TicketId"
                        value="@Model.Ticket.TicketId" />

                    <button type="submit"
                            class="status-badge @(Model.Ticket.Open
                                ? "status-badge--open"
                                : "status-badge--closed")">
                        <span class="status-badge__dot"></span>
                        @(Model.Ticket.Open ? "Open" : "Closed")
                    </button>
                </form>
            </header>

            <div class="ticket-layout">
                <section class="ticket-main">
                    <article class="ticket-description">
                        <h2>Request</h2>
                        <div class="ticket-description__content">@Model.Ticket.Text</div>
                    </article>

                    <section class="conversation">
                        <div class="section-heading">
                            <div>
                                <h2>Exchange</h2>
                                <p>
                                    @(Model.Ticket.Exchange.Count > 1 ? Model.Ticket.Exchange.Count.ToString() + " messages" : Model.Ticket.Exchange.Count.ToString() + " message" )
                                </p>
                            </div>
                        </div>

                        @if (Model.Ticket.Exchange.Any())
                        {
                            <div class="message-list">
                                @foreach (Message message in Model.Ticket.Exchange.OrderBy(m => m.CreationDate))
                                {
                                    <article class="message">
                                        <div class="message-avatar">
                                            @message.User.UserId
                                        </div>

                                        <div class="message-body">
                                            <div class="message-header">
                                                <strong>
                                                    @message.User.FirstName
                                                    @message.User.LastName
                                                </strong>
                                                <time>
                                                    @message.CreationDate.ToString(format: "dd MMM yyyy, HH:mm")
                                                </time>
                                            </div>

                                            <div class="message-content">@LinkHelper.Linkify(message.Text)</div>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="conversation-empty">
                                <p>No messages yet.</p>
                                <span>Send the first reply using the form below.</span>
                            </div>
                        }
                    </section>
                </section>

                <aside>

                    @if (Model.Ticket.Open)
                    {
                        <form method="post"
                              asp-page-handler="SendMessage"
                              class="reply-form">

                            <input type="hidden"
                                   name="TicketId"
                                   value="@Model.Ticket.TicketId" />

                            <input type="hidden"
                                   name="UserId"
                                   value="@Model.Ticket.UserId" />

                            <div asp-validation-summary="ModelOnly"
                                 class="validation-summary">
                            </div>

                            <div class="form-group">
                                <label asp-for="Text">Message</label>

                                <textarea asp-for="Text"
                                          class="message-input"
                                          rows="9"
                                          placeholder="Write your reply here..."></textarea>

                                <span asp-validation-for="Text"
                                      class="validation-error">
                                </span>
                            </div>

                            <button type="submit" class="button button--primary">
                                <span>Send message</span>
                                <span aria-hidden="true">→</span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="closed-notice">
                            <strong>This ticket is closed</strong>
                            <p>New messages cannot be added to a closed ticket.</p>
                        </div>
                    }
                </aside>
            </div>
        </main>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}