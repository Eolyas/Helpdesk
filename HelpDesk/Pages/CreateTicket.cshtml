@page
@model CreateTicketModel

<h1>@ViewData[index: "Title"]</h1>


<form asp-controller="Tickets" asp-action="Submit" method="post">
    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>
    <div>
        <label>Message</label>
        <input asp-for="Text" />
    </div>
    <div>
        <label>Your ID</label>
        <input asp-for="UserId" />
    </div>
    <button type="submit">Submit</button>
</form>