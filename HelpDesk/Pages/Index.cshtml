@page
@model IndexModel
@{
    ViewData[index: "Title"] = "Home page";
}

<div class="text-center">
    <ul>
        @foreach (Ticket ticket in Model.Tickets)
        {
            <li>
                <h2>
                    <a asp-page="/ViewTicket"asp-route-id="@ticket.id">
                        @ticket.title
                    </a>
                </h2>
                <p>@ticket.message</p>
            </li>
        }
    </ul>
</div>