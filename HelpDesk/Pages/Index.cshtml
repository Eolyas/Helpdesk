@page
@model IndexModel
@using HelpDesk.Models
@using System.Linq

@{
    ViewData[index: "Title"] = "Open Tickets";

    IEnumerable<Ticket> openTickets = Model.Tickets
        .Where(ticket => ticket.Open)
        .OrderByDescending(ticket => ticket.CreationDate);
}

<div class="ticket-page">
    <main class="ticket-container">
        <header class="ticket-header">
            <div class="ticket-header__content">
                <span>Help desk</span>

                <h1>Open Tickets</h1>

                <p>
                    View and manage all support requests currently in progress.
                </p>
            </div>

            <div>
                <strong>@openTickets.Count()</strong>
                <span>Open ticket@(openTickets.Count() == 1 ? "" : "s")</span>
            </div>
        </header>

        <section>
            <div>
                <a asp-page="/CreateTicket" class="button button--primary">
                    <span aria-hidden="true">+</span>
                    New ticket
                </a>
            </div>

            @if (!openTickets.Any())
            {
                <div class="ticket-empty">
                    <div class="ticket-empty__icon" aria-hidden="true">✓</div>

                    <h2>No open tickets</h2>

                    <p>
                        Everything is up to date. New support requests will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="tickets-grid">
                    @foreach (Ticket ticket in openTickets)
                    {
                        <article class="ticket-card">
                            <div class="ticket-card__top">
                                <span>
                                    @ticket.TicketId
                                </span>

                                <span class="status-badge status-badge--open">
                                    <span class="status-badge__dot"></span>
                                    Open
                                </span>

                                <time class="ticket-date"
                                    datetime="@ticket.CreationDate.ToString(format: "O")">
                                    @ticket.CreationDate.ToString(format: "dd MMM yyyy, HH:mm")
                                </time>
                            </div>

                            <div>
                                <h2 class="ticket-card__heading">
                                    <a asp-page="/ViewTicket"
                                       asp-route-id="@ticket.TicketId">
                                        @ticket.Title
                                    </a>
                                </h2>
                                <p class="ticket-card__description">
                                    @ticket.Text
                                </p>
                            </div>

                            <footer class="ticket-card__footer">
                                @if (ticket.User != null)
                                {
                                    <strong>
                                        @ticket.User.FirstName @ticket.User.LastName
                                    </strong>
                                }
                                else
                                {
                                    <strong>Unknown user</strong>
                                }
                            </footer>
                        </article>
                    }
                </div>
            }
        </section>
    </main>
</div>