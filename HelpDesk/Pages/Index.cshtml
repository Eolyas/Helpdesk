@page
@model IndexModel
@using HelpDesk.Models
@using System.Linq

@{
    ViewData[index: "Title"] = "Open Tickets";

    IEnumerable<Ticket> openTickets = Model.Tickets
        .Where(ticket => ticket.Open)
        .OrderByDescending(ticket => ticket.CreationDate);
}

<div class="tickets-page">
    <main class="tickets-container">
        <header class="tickets-header">
            <div class="tickets-header__content">
                <span class="tickets-header__label">Help desk</span>

                <h1>Open Tickets</h1>

                <p>
                    View and manage all support requests currently in progress.
                </p>
            </div>

            <div class="tickets-counter">
                <strong>@openTickets.Count()</strong>
                <span>Open ticket@(openTickets.Count() == 1 ? "" : "s")</span>
            </div>
        </header>

        <section class="tickets-content">
            <div class="tickets-toolbar">
                <div>
                    <h2>Current requests</h2>
                    <p>Tickets are ordered from newest to oldest.</p>
                </div>

                @* Update the page path if your ticket creation page has another name. *@
                <a asp-page="/CreateTicket" class="button button--primary tickets-create">
                    <span aria-hidden="true">+</span>
                    New ticket
                </a>
            </div>

            @if (!openTickets.Any())
            {
                <div class="tickets-empty">
                    <div class="tickets-empty__icon" aria-hidden="true">✓</div>

                    <h2>No open tickets</h2>

                    <p>
                        Everything is up to date. New support requests will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="tickets-grid">
                    @foreach (Ticket ticket in openTickets)
                    {
                        <article class="ticket-card">
                            <div class="ticket-card__header">
                                <span class="ticket-card__reference">
                                    Ticket #@ticket.TicketId
                                </span>

                                <span class="status-badge status-badge--open">
                                    <span class="status-badge__dot"></span>
                                    Open
                                </span>
                            </div>

                            <div class="ticket-card__body">
                                <h2 class="ticket-card__title">
                                    <a asp-page="/ViewTicket"
                                       asp-route-id="@ticket.TicketId">
                                        @ticket.Title
                                    </a>
                                </h2>

                                <p class="ticket-card__description">
                                    @ticket.Text
                                </p>
                            </div>

                            <footer class="ticket-card__footer">
                                <div class="ticket-card__user">
                                    <span class="ticket-card__avatar">
                                        @if (ticket.User != null)
                                        {
                                            @(ticket.User.FirstName?.FirstOrDefault())@(ticket.User.LastName?.FirstOrDefault())
                                        }
                                        else
                                        {
                                            @:?
                                        }
                                    </span>

                                    <span class="ticket-card__user-info">
                                        @if (ticket.User != null)
                                        {
                                            <strong>
                                                @ticket.User.FirstName @ticket.User.LastName
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong>Unknown user</strong>
                                        }

                                        <time datetime="@ticket.CreationDate.ToString(format: "O")">
                                            @ticket.CreationDate.ToString(format: "dd MMM yyyy, HH:mm")
                                        </time>
                                    </span>
                                </div>

                                <a asp-page="/ViewTicket"
                                   asp-route-id="@ticket.TicketId"
                                   class="ticket-card__link"
                                   aria-label="View ticket @ticket.Title">
                                    View ticket
                                    <span aria-hidden="true">→</span>
                                </a>
                            </footer>
                        </article>
                    }
                </div>
            }
        </section>
    </main>
</div>