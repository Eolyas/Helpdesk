@page
@model IndexModel

<h1>Tickets</h1>

@if (Model.Tickets.Count == 0)
{
    <p>No tickets found.</p>
}
else
{
    <ul>
        @foreach (Models.Ticket ticket in Model.Tickets)
        {
            <li>
                <a asp-page="/ViewTicket"
                   asp-route-id="@ticket.TicketId">
                    @ticket.Title
                </a>

                <p>@ticket.Text</p>
            </li>
        }
    </ul>
}