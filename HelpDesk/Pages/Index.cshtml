@page
@model IndexModel
@using HelpDesk.Models
@{
    ViewData[index: "Title"] = "Home page";
}

<div class="text-center">
    <ul>
        @foreach (Ticket Ticket in ListData.Tickets)
        {
            if (Ticket.Id !=0){
                <li>
                    <h2>
                        <a asp-page="/ViewTicket"asp-route-id="@Ticket.Id">
                            @Ticket.Title
                        </a>
                    </h2>
                    <p>@Ticket.Message</p>
                </li>
            }
        }
    </ul>
</div>